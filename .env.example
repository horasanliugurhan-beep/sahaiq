# Copy to .env.local and provide values locally. Never commit real secrets.

# Optional Qlik Cloud connector
QLIK_TENANT_URL=
QLIK_API_KEY=
QLIK_APP_ID=

# Reserved for a future OAuth-based Qlik deployment
QLIK_CLIENT_ID=
QLIK_CLIENT_SECRET=

# /api/qlik status check is disabled unless both are set (token: 32+ random chars)
SAHAIQ_ENABLE_QLIK_CHECK=false
SAHAIQ_STATUS_TOKEN=
