# Copy to .env.local. Never commit actual credentials or paste them into chat.
# File observer pilot works without any of these values.

# Metadata check is off by default. Enable only after company authorization.
SAHAIQ_ENABLE_QLIK_CHECK=false
# Random server-side status token, at least 32 characters; never NEXT_PUBLIC_.
SAHAIQ_STATUS_TOKEN=
QLIK_TENANT_URL=
QLIK_API_KEY=
QLIK_APP_ID=

# Reserved for future OAuth setup; not currently implemented.
QLIK_CLIENT_ID=
QLIK_CLIENT_SECRET=
