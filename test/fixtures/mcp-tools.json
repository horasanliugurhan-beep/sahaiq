  {
    "name": "get_call_list",
    "title": "Arama listesi",
    "description": "Bugün kimin aranacağına dair gerekçeli öncelik listesi (yüksek, orta, düşük). Sıra, SahaIQ'nun öncelik ve müşteri değeri kurallarından gelir; her kayıtta gerekçe ve önerilen sonraki adım var.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "yüksek",
            "orta",
            "düşük"
          ],
          "description": "Yalnızca bu öncelik."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "En fazla kaç kayıt (1–100)."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Arama listesi",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_customers",
    "title": "Müşteri listesi",
    "description": "Müşteriler; RFM puanı ve segmenti, son alım, toplam ciro ve son 90 günün önceki 90 güne göre değişimiyle. Segment ve bölgeye göre süzülebilir, ciroya, değişime veya son alıma göre sıralanabilir.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "segment": {
          "type": "string",
          "enum": [
            "champion",
            "loyal",
            "at_risk",
            "new",
            "standard",
            "dormant",
            "no_purchase"
          ],
          "description": "RFM segmenti."
        },
        "region": {
          "type": "string",
          "maxLength": 40,
          "description": "Bölge adı (ör. Kuzey)."
        },
        "sort": {
          "type": "string",
          "enum": [
            "total_desc",
            "change_asc",
            "change_desc",
            "recency_desc",
            "name_asc"
          ],
          "description": "Sıralama. change_asc: en çok düşenler önce."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "En fazla kaç kayıt (1–100)."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Müşteri listesi",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
